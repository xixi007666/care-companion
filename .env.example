# Generate a unique 32-byte key once per deployment:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# One container / one persistent volume pilot database. Do not commit this file.
DATABASE_PATH=./data/care-companion.sqlite
PORT=3000
COOKIE_SECURE=false

# Only for the included local mock provider. Production must keep this false.
ALLOW_HTTP_LLM=false

# 1–100 calls per rolling hour per user. BYOK still needs a ceiling to limit abuse.
AI_CALLS_PER_HOUR=20
